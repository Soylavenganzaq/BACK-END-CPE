# Copia este archivo a .env y reemplaza los valores localmente.
# El backend no abre conexiones mientras DATABASE_URL no sea solicitada por un adaptador.
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@localhost:5432/preconfiguracion_db
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
PORT=4729
FLASK_DEBUG=false